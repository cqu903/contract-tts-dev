# Engine: gptsovits (local Cantonese only) or bailian (cloud multilingual)
CONTRACT_TTS_ENGINE=bailian

# Local GPT-SoVITS settings; relative paths are resolved from the project root
GPTSOVITS_ENGINE_URL=http://127.0.0.1:9880
GPTSOVITS_REF_AUDIO=refs/cantonese_ref_trim.wav
GPTSOVITS_REF_PROMPT=refs/cantonese_ref_trim.txt

# Required when CONTRACT_TTS_ENGINE=bailian
DASHSCOPE_API_KEY=replace-with-your-api-key

# Bailian voices selected by Template profile
BAILIAN_VOICE=longjiaxin_v3
BAILIAN_VOICE_ZH=longxiaochun
BAILIAN_VOICE_EN=longanyang

# Bump only the affected profile when voice/model/reference/synthesis settings change
ENGINE_PROFILE_CACHE_VERSION_YUE=v1
ENGINE_PROFILE_CACHE_VERSION_ZH=v1
ENGINE_PROFILE_CACHE_VERSION_EN=v1
