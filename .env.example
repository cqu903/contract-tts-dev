# Fallback engine. Each language can override it independently below.
# Accepted names: gptsovits, cosyvoice (alias: bailian).
CONTRACT_TTS_ENGINE=bailian
CONTRACT_TTS_ENGINE_YUE=cosyvoice
CONTRACT_TTS_ENGINE_ZH=cosyvoice
CONTRACT_TTS_ENGINE_EN=cosyvoice

# Local GPT-SoVITS settings; relative paths are resolved from the project root
GPTSOVITS_ENGINE_URL=http://127.0.0.1:9880
GPTSOVITS_REF_AUDIO=refs/cantonese_ref_trim.wav
GPTSOVITS_REF_PROMPT=refs/cantonese_ref_trim.txt
GPTSOVITS_REF_PROMPT_LANG=yue
# The app already segments Cantonese contracts. Avoid a second punctuation cut
# and keep only a short natural pause between generated pieces.
GPTSOVITS_FRAGMENT_INTERVAL_YUE=0.05
GPTSOVITS_TEXT_SPLIT_METHOD_YUE=cut0
# Set this to the server/container path when GPT-SoVITS runs on another host.
# GPTSOVITS_REF_AUDIO_ENGINE_PATH=/opt/GPT-SoVITS/references/cantonese_ref_trim.wav

# Optional native-language references. When omitted, Mandarin and English use
# the common Cantonese reference above in GPT-SoVITS cross-language mode.
# GPTSOVITS_REF_AUDIO_ZH=refs/mandarin_ref_trim.wav
# GPTSOVITS_REF_AUDIO_ENGINE_PATH_ZH=/opt/GPT-SoVITS/references/mandarin_ref_trim.wav
# GPTSOVITS_REF_PROMPT_ZH=refs/mandarin_ref_trim.txt
# GPTSOVITS_REF_PROMPT_LANG_ZH=zh
# GPTSOVITS_REF_AUDIO_EN=refs/english_ref_trim.wav
# GPTSOVITS_REF_AUDIO_ENGINE_PATH_EN=/opt/GPT-SoVITS/references/english_ref_trim.wav
# GPTSOVITS_REF_PROMPT_EN=refs/english_ref_trim.txt
# GPTSOVITS_REF_PROMPT_LANG_EN=en

# Required when any language profile uses cosyvoice/bailian
DASHSCOPE_API_KEY=replace-with-your-api-key

# Bailian transport: http (mainland China) or wss (for example Singapore)
BAILIAN_TRANSPORT=http
BAILIAN_HTTP_BASE_URL=https://dashscope.aliyuncs.com
BAILIAN_WS_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/inference
BAILIAN_MODEL=cosyvoice-v3-flash
# Optional: set this when the Bailian console provides a workspace-specific host
BAILIAN_WORKSPACE_ID=

# Bailian voices selected by Template profile
BAILIAN_VOICE=longjiaxin_v3
BAILIAN_VOICE_ZH=longxiaochun
BAILIAN_VOICE_EN=longanyang

# Bump only the affected profile when voice/model/reference/synthesis settings change
ENGINE_PROFILE_CACHE_VERSION_YUE=v2
ENGINE_PROFILE_CACHE_VERSION_ZH=v1
ENGINE_PROFILE_CACHE_VERSION_EN=v1
