# Python
__pycache__/
*.py[cod]
.venv/
.python-version.local

# Jupyter
.ipynb_checkpoints/

# Models / caches (HF caches live in ~/.cache by default; ignore any local stray)
*.mlx
models/

# Keep generated samples (they are deliverable evidence), but ignore bulk raw dumps
raw_dumps/

# SDD workspace (git-ignored scratch)
.superpowers/

# seek_probe spike
seek_probe/cache/
# uploaded contract originals (external uploads) — PII, never tracked
seek_probe/uploaded/
seek_probe/refs/*.wav
seek_probe/refs/*.mp3
# generated A/B verification audio clips
seek_probe/verify/

# Real contract texts may contain PII (names, ID numbers, addresses);
# only the synthetic sample is tracked.
seek_probe/contracts/*
!seek_probe/contracts/sample_contract.txt

# OS / logs
.DS_Store
*.log
