  "cards": [
    { "dot": "cyan", "title": "内容寻址", "items": [
      "contract_id = sha256(template_id | 原文)：同文同 id，重复上传幂等",
      "cache_key 覆盖模板、归一化文本、引擎 Profile、缓存版本与合成指纹",
      "相同样板段落跨合同复用同一段音频"
    ] },
    { "dot": "emerald", "title": "按需合成", "items": [
      "上传后后台预热第 0 段，首次播放即点即响",
      "preload 端点在后台预合成后续段",
      "per-key asyncio.Lock：并发相同请求只合成一次"
    ] },
    { "dot": "violet", "title": "引擎可替换", "items": [
      "三个适配器同构：synth(text) → AsyncIterator[bytes]",
      "按朗读语言（yue / zh / en）独立选择引擎",
      "整段收齐后再响应，引擎失败回明确 502"
    ] },
    { "dot": "amber", "title": "数据保留", "items": [
      "原文 90 天（创建时间），音频 30 天滑动窗口（命中续期）",
      "启动清一次 + 进程内每日清理任务（ADR-0007）",
      "段文本不随索引回传，PII 不多过一趟网（ADR-0001）"
    ] }
