# Compose host port. The container always listens on 8000.
CONTRACT_TTS_PORT=8001

# All three Reading Languages use the stable Microsoft Provider.
CONTRACT_TTS_ENGINE=microsoft
CONTRACT_TTS_ENGINE_YUE=microsoft
CONTRACT_TTS_ENGINE_ZH=microsoft
CONTRACT_TTS_ENGINE_EN=microsoft

MICROSOFT_TTS_DRIVER=azure
MICROSOFT_TTS_VOICE_YUE=zh-HK-HiuGaaiNeural
MICROSOFT_TTS_RATE_YUE=+33.33%
MICROSOFT_TTS_VOICE_ZH=zh-CN-XiaoyuMultilingualNeural
MICROSOFT_TTS_RATE_ZH=0%
MICROSOFT_TTS_VOICE_EN=en-US-AriaNeural
MICROSOFT_TTS_RATE_EN=-15.00%

# Key and Region must belong to the same organization-managed Speech resource.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Leave empty for normal regional SDK mode. Only set an Azure-provided custom or
# private HTTPS resource endpoint; do not paste /cognitiveservices/v1 here.
AZURE_SPEECH_ENDPOINT=

# Manual cache invalidation remains available in addition to the automatic
# Driver/voice/rate/format/SDK fingerprint.
ENGINE_PROFILE_CACHE_VERSION_YUE=v2
ENGINE_PROFILE_CACHE_VERSION_ZH=v1
ENGINE_PROFILE_CACHE_VERSION_EN=v1
